# ============================================================
# LeadIQ CRM — Environment Variables
# Copy this file: cp .env.example .env
# ============================================================

# PostgreSQL
POSTGRES_DB=leadiq
POSTGRES_USER=leadiq_user
POSTGRES_PASSWORD=leadiq_secure_pass_123
DATABASE_URL=postgresql://leadiq_user:leadiq_secure_pass_123@postgres:5432/leadiq

# Redis
REDIS_URL=redis://:leadiq_redis_pass_123@redis:6379
REDIS_PASSWORD=leadiq_redis_pass_123

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_256_bits_long
JWT_REFRESH_SECRET=change_this_to_another_very_long_random_secret_for_refresh_tokens
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Backend
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
AI_AGENTS_URL=http://ai-agents:8000
LOG_LEVEL=debug

# AI — Anthropic Claude
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-4-5

# Email — SendGrid
# Get key: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-key-here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=LeadIQ CRM

# Lead Sources — SerpAPI (https://serpapi.com)
SERP_API_KEY=your-serpapi-key

# Lead Sources — GitHub (https://github.com/settings/tokens)
GITHUB_TOKEN=ghp_your-github-token

# Lead Sources — Product Hunt (https://www.producthunt.com/v2/oauth/applications)
PRODUCT_HUNT_API_KEY=your-ph-key
PRODUCT_HUNT_API_SECRET=your-ph-secret

# Frontend public vars
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=LeadIQ CRM
